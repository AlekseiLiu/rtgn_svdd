{
  "data": {
    "days": {
      "tuesday": "data/tuesday.csv",
      "wednesday": "data/wednesday.csv"
    },
    "feature_columns": null,
    "num_train": 200000,
    "num_validation": 70000
  },
  "evaluation": {
    "allow_self_edges": false,
